#!/bin/sh
fail() { echo "Echo push blocked: $*" >&2; exit 1; }
[ "$1" = origin ] || fail "Use origin."
case "$2" in
  https://github.com/notziking8/Echo_Island_Game.git|https://github.com/notziking8/Echo_Island_Game|git@github.com:notziking8/Echo_Island_Game.git) ;;
  *) fail "Unexpected repository URL: $2" ;;
esac
while read -r local_ref local_oid remote_ref remote_oid; do
  [ "$local_ref" = refs/heads/Echo_System ] || fail "Push the Echo_System branch only."
  [ "$remote_ref" = refs/heads/Echo_System ] || fail "Destination must be Echo_System."
  case "$remote_oid" in 0000000000000000000000000000000000000000) fail "Expected the existing remote Echo_System branch." ;; esac
  git merge-base --is-ancestor "$remote_oid" "$local_oid" || fail "Fetch and reconcile the branch; non-fast-forward pushes are disabled."
  commits=$(git rev-list "$remote_oid..$local_oid") || fail "Cannot inspect outgoing commits."
  for commit in $commits; do
    files=$(git diff-tree --root -m --no-commit-id --name-only -r "$commit") || fail "Cannot inspect changed files."
    invalid=$(printf '%s\n' "$files" | LC_ALL=C grep -Ev '^(systems/echo/.*|\.githooks/pre-push|)$')
    [ -z "$invalid" ] || fail "Changes outside Hali's Echo scope in $commit:
$invalid
Coordinate shared changes separately before pushing."
  done
done
exit 0
